Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteRule ^assets/og-share\.jpg$ api/ogimg.php?share=1 [L,QSA]
  RewriteRule ^assets/mail-logo-c\.(png|jpg|gif|webp)$ api/maillogo.php [L,QSA]
  RewriteRule ^assets/igp/([a-f0-9]{16})\.jpg$ api/igimg.php?id=$1 [L,QSA]
  RewriteRule ^assets/og-p/([A-Za-z0-9_-]{1,80})\.jpg$ api/ogimg.php?id=$1 [L,QSA]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|meta-externalfetcher|Twitterbot|LinkedInBot|WhatsApp|TelegramBot|Pinterest|Slackbot|Discordbot|Viber|SkypeUriPreview) [NC]
  RewriteRule ^(index\.html)?$ api/p.php?page=home [L,QSA]

  RewriteCond %{DOCUMENT_ROOT}/api/data/public.flag -f
  RewriteRule .* - [E=BKPUBLIC:1]
  RewriteCond %{ENV:BKPUBLIC} =1
  RewriteRule ^robots\.txt$ robots-public.txt [L]

  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|acunetix|nessus|havij|zgrab|wpscan|dirbuster|gobuster|netsparker|fimap|jaeles|nuclei|libwww-perl) [NC]
  RewriteRule .* - [F,L]
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(bak|old|orig|sql|log|ini|sh|env|swp|dist)$ - [F,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|vendor|cgi-bin) - [F,L]

  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
  RewriteRule ^en/?$ /#/en/ [R=302,NE,L]
  RewriteRule ^en/termek/([A-Za-z0-9_-]+)/?$ api/p.php?lang=en&id=$1 [L,QSA]
  RewriteRule ^termek/([A-Za-z0-9_-]+)/?$ api/p.php?id=$1 [L,QSA]
  RewriteRule ^en/(rolunk|kapcsolat|szallitas|aszf|adatvedelem|elallas|impresszum)/?$ api/p.php?lang=en&page=$1 [L,QSA]
  RewriteRule ^(rolunk|kapcsolat|szallitas|aszf|adatvedelem|elallas|impresszum)/?$ api/p.php?page=$1 [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

<FilesMatch "^_.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=!BKPUBLIC
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header unset X-Powered-By
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set X-Permitted-Cross-Domain-Policies "none"
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^bk-sw\.js$">
    Header set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
