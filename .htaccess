# Bagdi Kata – tesztverzió (Apache / cPanel tárhely)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{DOCUMENT_ROOT}/api/data/public.flag -f
  RewriteRule .* - [E=BKPUBLIC:1]
  RewriteCond %{ENV:BKPUBLIC} =1
  RewriteRule ^robots\.txt$ robots-public.txt [L]

  # --- Botok és szkennerek kizárása ---------------------------------------------
  RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|nmap|masscan|acunetix|nessus|havij|zgrab|wpscan|dirbuster|gobuster|netsparker|fimap|jaeles|nuclei|libwww-perl) [NC]
  RewriteRule .* - [F,L]
  # rejtett fájlok (.git, .env ...), mentések, naplók, és tipikus kártevő-próbálkozások
  RewriteRule (^|/)\.(?!well-known) - [F,L]
  RewriteRule \.(bak|old|orig|sql|log|ini|sh|env|swp|dist)$ - [F,L]
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|xmlrpc\.php|phpmyadmin|pma|vendor|cgi-bin) - [F,L]

  # --- Keresőbarát címek ----------------------------------------------------------
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
  RewriteRule ^en/?$ /#/en/ [R=302,NE,L]
  RewriteRule ^en/termek/([A-Za-z0-9_-]+)/?$ api/p.php?lang=en&id=$1 [L,QSA]
  RewriteRule ^termek/([A-Za-z0-9_-]+)/?$ api/p.php?id=$1 [L,QSA]
  RewriteRule ^en/(rolunk|kapcsolat|szallitas|aszf|adatvedelem|elallas|impresszum)/?$ api/p.php?lang=en&page=$1 [L,QSA]
  RewriteRule ^(rolunk|kapcsolat|szallitas|aszf|adatvedelem|elallas|impresszum)/?$ api/p.php?page=$1 [L,QSA]
</IfModule>

# a segédfájlok (_lib.php, _mail.php ...) közvetlenül nem hívhatók
<FilesMatch "^_.*\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  # Jelszóval védett módban nem indexelhető; nyilvános módban (api/data/public.flag) igen
  Header set X-Robots-Tag "noindex, nofollow" env=!BKPUBLIC
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header unset X-Powered-By
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # a JS/CSS fájlok minden betöltéskor ellenőrzésre kerülnek (a frissítések azonnal látszanak)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Erősebb, tárhely szintű jelszó (ajánlott) ---------------------------------
# A cPanelben: „Directory Privacy” / „Jelszóval védett könyvtárak” → pipa + felhasználó.
# Vagy kézzel: töltsd fel a .htpasswd fájlt a nyilvános mappán KÍVÜLRE, írd be az elérési útját,
# majd töröld a # jeleket az alábbi 4 sor elől. (Lásd TELEPITES.md)
# AuthType Basic
# AuthName "Bagdi Kata tesztverzio"
# AuthUserFile /home/FELHASZNALO/.htpasswd
# Require valid-user
